.DS_Store
__pycache__/

# Tooling scratch
.playwright-mcp/
*.bak

# This repository holds the skill only: rule prose, design tokens, entry points,
# and the check scripts. Deliverables produced *with* the skill — decks, reports,
# their exports and renders — live with the engagement, never here. Committing one
# would also breach the no-engagement-facts red line in CLAUDE.md.
*.pdf
*.pptx
*.docx
*.key
*.numbers
*.xlsx
*.mp4
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.woff
*.woff2
*.ttf
*.otf

# Skill-validation output. Deliverables built to exercise the rules used to land
# in docs/ so they could be checked in place; they carry engagement facts and a
# client name, which CLAUDE.md red line 9 bars from this repository. As of
# 0.1.385 they land in the user's own Documents/LUMI-Style/ like every other
# deliverable, so red line 9 is held by the directory structure rather than by
# this file. The entry stays as a net: a rule enforced only by .gitignore is one
# `git add -f` away from being broken, and the directory is the one place a
# validation run has historically reached for.
docs/

# Exception: the design language's own assets are part of the skill, not renders.
# design-rules.md requires embedding them, and a version that shipped with the
# face declared but not vendored rendered nothing (CHANGELOG 1.2.0). The icons
# and geography added in 1.8.0 sit behind the same blanket *.svg rule and would
# have been dropped the same silent way.
!assets/fonts/*.woff2
!assets/icons/**/*.svg
!assets/vectors/*.svg
# LUMIVATE's brand marks. Generated, locked, and shipped — the blanket
# *.svg above is there to keep stray artwork out, not the package's own
# generated vectors, and this is the fourth directory to need saying so.
!assets/brand/**/*.svg

# Conformance run artifacts: renders, not records. The scoreboard is tracked;
# the raw agent output lives with the run.
conformance/results/

# inspect_layout contact sheets are renders, not records.
fixtures/_layout/

# inspect_layout contact sheets are renders, not records — the same reason
# fixtures/_layout is ignored.
backlog/_layout/
# A rendered deck slipped in as backlog/ideas-prd.en.html once (deleted at
# 0.1.436): *.html was never in this list, so the deliverable ban had a hole.
backlog/*.html

# Claude Code worktrees: separate checkouts, not content of this one.
.claude/worktrees/

# The Evals corpus paths are the operator machine's, not the package's
# (red line 9: no engagement facts in a tracked file).
evals/corpus.local.json
